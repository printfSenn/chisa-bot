DISCORD_TOKEN_ZETA=

# OpenAI-compatible chat completion API.
# The legacy MISTRAL_API_KEY variable is still supported.
AI_PROVIDER=mistral
AI_API_KEY=
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-latest
AI_MAX_TOKENS=300

# Optional. Without a database, the bot can still run locally, but
# memories, AFK persistence, quotes, and activity tracking are disabled.
DATABASE_URL=
WEATHER_KEY=
GAME_SAVE_SECRET=

# Optional channel configuration. Values are comma-separated Discord IDs.
ZETA_SCHEDULED_CHANNEL_IDS=
ZETA_RANDOM_CHANNEL_IDS=
ZETA_MORNING_CHANNEL_IDS=
ZETA_MORNING_HOUR_WIB=7
ZETA_MORNING_MINUTE_WIB=0
